{
  "name": "@subculture/project-template-ts-vite-react-ts-postgres-docker-web",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.e2e-contract.config.ts && node scripts/check-matrix-source-policy.mjs",
    "test:matrix-browser": "node scripts/build-browser-harness.mjs && playwright test --config playwright.config.ts --project=task8-matrix-oauth",
    "test:task9-sas-startup-quarantine": "node scripts/build-browser-harness.mjs && playwright test --config playwright.config.ts --project=task9-sas-startup-quarantine",
    "test:task9-sas-startup-quarantine:chromium": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium pnpm run test:task9-sas-startup-quarantine",
    "test:task9-local": "node ../scripts/test-task9-local.mjs",
    "test:g2-encrypted-direct-chat": "playwright test --config playwright.config.ts --project=g2-encrypted-direct-chat",
    "format": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e-contract.json --noEmit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "matrix-js-sdk": "42.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.55.0",
    "@types/node": "^24.10.1",
    "@testing-library/react": "16.3.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.4",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.5",
    "vitest": "^4.0.8"
  }
}
