{
  "name": "local",
  "networks": {
    "canary": {
      "internal": true,
      "ipam": {
        "config": [
          {
            "gateway": "10.77.32.1",
            "subnet": "10.77.32.0/24"
          }
        ]
      },
      "name": "local_canary"
    },
    "control-egress": {
      "ipam": {},
      "name": "local_control-egress"
    },
    "control-internal": {
      "internal": true,
      "ipam": {
        "config": [
          {
            "gateway": "10.77.31.1",
            "subnet": "10.77.31.0/24"
          }
        ]
      },
      "name": "local_control-internal"
    },
    "edge": {
      "ipam": {},
      "name": "local_edge"
    },
    "matrix-internal": {
      "internal": true,
      "ipam": {
        "config": [
          {
            "gateway": "10.77.30.1",
            "subnet": "10.77.30.0/24"
          }
        ]
      },
      "name": "local_matrix-internal"
    }
  },
  "secrets": {
    "control-owner-db-password": {
      "file": "<repo>/deploy/local/policy-fixtures/control-owner-db-password",
      "name": "local_control-owner-db-password"
    },
    "control-retention-db-password": {
      "file": "<repo>/deploy/local/policy-fixtures/control-retention-db-password",
      "name": "local_control-retention-db-password"
    },
    "control-revocation-db-password": {
      "file": "<repo>/deploy/local/policy-fixtures/control-revocation-db-password",
      "name": "local_control-revocation-db-password"
    },
    "control-runtime-db-password": {
      "file": "<repo>/deploy/local/policy-fixtures/control-runtime-db-password",
      "name": "local_control-runtime-db-password"
    },
    "mas-db-password": {
      "file": "<repo>/deploy/local/policy-fixtures/mas-db-password",
      "name": "local_mas-db-password"
    },
    "mas-encryption-key": {
      "file": "<repo>/deploy/local/policy-fixtures/mas-encryption-key",
      "name": "local_mas-encryption-key"
    },
    "mas-secrets.yaml": {
      "file": "<repo>/deploy/local/policy-fixtures/mas-secrets.yaml",
      "name": "local_mas-secrets.yaml"
    },
    "mas-signing-key.pem": {
      "file": "<repo>/deploy/local/policy-fixtures/mas-signing-key.pem",
      "name": "local_mas-signing-key.pem"
    },
    "mas-upstream-client-secret": {
      "file": "<repo>/deploy/local/policy-fixtures/mas-upstream-client-secret",
      "name": "local_mas-upstream-client-secret"
    },
    "matrix-root-password": {
      "file": "<repo>/deploy/local/policy-fixtures/matrix-root-password",
      "name": "local_matrix-root-password"
    },
    "oidc-cookie-keys": {
      "file": "<repo>/secrets/oidc-cookie-keys.json",
      "name": "local_oidc-cookie-keys"
    },
    "oidc-signing-jwks": {
      "file": "<repo>/secrets/oidc-signing-jwks.json",
      "name": "local_oidc-signing-jwks"
    },
    "synapse-db-password": {
      "file": "<repo>/deploy/local/policy-fixtures/synapse-db-password",
      "name": "local_synapse-db-password"
    },
    "synapse-mas-shared-secret": {
      "file": "<repo>/deploy/local/policy-fixtures/synapse-mas-shared-secret",
      "name": "local_synapse-mas-shared-secret"
    },
    "synapse-secrets.yaml": {
      "file": "<repo>/deploy/local/policy-fixtures/synapse-secrets.yaml",
      "name": "local_synapse-secrets.yaml"
    },
    "synapse-signing-key": {
      "file": "<repo>/deploy/local/policy-fixtures/synapse-signing-key",
      "name": "local_synapse-signing-key"
    }
  },
  "services": {
    "api": {
      "build": {
        "args": {
          "BUILD_MARKER": "development",
          "NODE_IMAGE": "node@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd"
        },
        "context": "<repo>",
        "dockerfile": "backend/Dockerfile"
      },
      "command": [
        "sh",
        "/usr/local/bin/local-api-entrypoint.sh"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "APP_ENV": "development",
        "AUTHORITY_POLICY_VERSION": "v1",
        "CHALLENGE_KEY_RING": "replace-with-existing-control-plane-value",
        "CONTROL_PLANE_RETENTION_ROLE": "control_retention",
        "CONTROL_PLANE_REVOCATION_ROLE": "control_revocation",
        "CONTROL_PLANE_RUNTIME_ROLE": "control_runtime",
        "COOKIE_KEY": "replace-with-existing-control-plane-value",
        "COOKIE_SECURE": "true",
        "ENVELOPE_KEY_RING": "replace-with-existing-control-plane-value",
        "FOUNDATION_BASE_URL": "https://foundation.example",
        "IDEMPOTENCY_KEY_RING": "replace-with-existing-control-plane-value",
        "JTI_KEY_RING": "replace-with-existing-control-plane-value",
        "MAS_CLIENT_ID": "dsa-signal",
        "MAS_CLIENT_SECRET_PATH": "/run/private-oidc/mas-client-secret",
        "MAS_REDIRECT_URI": "https://auth.localhost:8443/upstream/callback/01J00000000000000000000000",
        "OIDC_ADAPTER_KEY_RING": "replace-with-existing-control-plane-value",
        "OIDC_COOKIE_KEYS_PATH": "/run/private-oidc/oidc-cookie-keys.json",
        "OIDC_EPOCH": "AAAAAAAAAAAAAAAAAAAAAA",
        "OIDC_INDEX_KEY_RING": "replace-with-existing-control-plane-value",
        "OIDC_RESTORE_FLOOR_DIR": "/var/lib/dsa-signal/oidc-restore-floor",
        "OIDC_RESTORE_FLOOR_HEAD": "replace-with-external-floor-head",
        "OIDC_SECTOR": "https://auth.localhost:8443",
        "OIDC_SIGNING_JWKS_PATH": "/run/private-oidc/oidc-signing-jwks.json",
        "OIDC_TRUSTED_PROXY_ADDRESS": "10.77.31.10",
        "POLICY_MAX_STALENESS_SECONDS": "300",
        "PORT": "8080",
        "PUBLIC_BASE_URL": "https://chat.localhost:8443",
        "PWA_ORIGIN": "https://chat.localhost:8443",
        "REQUEST_FINGERPRINT_KEY_RING": "replace-with-existing-control-plane-value",
        "REVOCATION_EVIDENCE_KEY_RING": "replace-with-existing-control-plane-value",
        "ROOT_DIDS": "did:example:root",
        "ROOT_PUBLIC_JWKS": "{\"did:example:root#root\":{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"replace\"}}",
        "SESSION_BINDING_KEY_RING": "replace-with-existing-control-plane-value",
        "SUBJECT_KEY_RING": "replace-with-existing-control-plane-value"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 12,
        "test": [
          "CMD-SHELL",
          "node -e 'fetch(\"http://127.0.0.1:8080/health\").then(async r => { if (!r.ok || (await r.json()).status !== \"ok\") process.exit(1) }).catch(() => process.exit(1))'"
        ],
        "timeout": "5s"
      },
      "networks": {
        "control-egress": null,
        "control-internal": null
      },
      "profiles": [
        "full"
      ],
      "secrets": [
        {
          "source": "control-runtime-db-password",
          "target": "/run/secrets/control-runtime-db-password"
        },
        {
          "source": "oidc-signing-jwks",
          "target": "oidc-signing-jwks.json"
        },
        {
          "source": "mas-upstream-client-secret",
          "target": "mas-client-secret"
        },
        {
          "source": "oidc-cookie-keys",
          "target": "oidc-cookie-keys.json"
        }
      ],
      "tmpfs": [
        "/run/private-oidc:mode=0700",
        "/run/private-oidc-restore-floor:mode=0700"
      ],
      "user": "root",
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<repo>/deploy/local/api-entrypoint.sh",
          "target": "/usr/local/bin/local-api-entrypoint.sh",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "<repo>/secrets/oidc-restore-floor",
          "target": "/var/lib/dsa-signal/oidc-restore-floor",
          "type": "bind"
        }
      ]
    },
    "control-db": {
      "command": [
        "postgres",
        "-c",
        "max_connections=100"
      ],
      "entrypoint": null,
      "environment": {
        "CONTROL_PLANE_RETENTION_ROLE": "control_retention",
        "CONTROL_PLANE_REVOCATION_ROLE": "control_revocation",
        "CONTROL_PLANE_RUNTIME_ROLE": "control_runtime",
        "POSTGRES_DB": "control",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/control-owner-db-password",
        "POSTGRES_USER": "control_owner"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 12,
        "test": [
          "CMD-SHELL",
          "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""
        ],
        "timeout": "5s"
      },
      "image": "postgres@sha256:4f736ae292687621d4dbe0d499ffd024a36bd2ee7d8ca6f2ccd4c800f047b394",
      "networks": {
        "control-internal": null
      },
      "profiles": [
        "full"
      ],
      "secrets": [
        {
          "source": "control-owner-db-password",
          "target": "/run/secrets/control-owner-db-password"
        },
        {
          "source": "control-runtime-db-password",
          "target": "/run/secrets/control-runtime-db-password"
        },
        {
          "source": "control-retention-db-password",
          "target": "/run/secrets/control-retention-db-password"
        },
        {
          "source": "control-revocation-db-password",
          "target": "/run/secrets/control-revocation-db-password"
        }
      ],
      "volumes": [
        {
          "source": "control-db-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {},
          "read_only": true,
          "source": "<repo>/deploy/local/postgres/init-control-plane.sh",
          "target": "/docker-entrypoint-initdb.d/10-control.sh",
          "type": "bind"
        }
      ]
    },
    "egress-canary": {
      "command": null,
      "entrypoint": null,
      "image": "caddy@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648",
      "networks": {
        "canary": {
          "ipv4_address": "10.77.32.10"
        }
      },
      "profiles": [
        "negative"
      ],
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<repo>/deploy/local/canary/Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "type": "bind"
        }
      ]
    },
    "gateway": {
      "command": null,
      "entrypoint": null,
      "healthcheck": {
        "interval": "5s",
        "retries": 12,
        "test": [
          "CMD-SHELL",
          "test -r /data/caddy/pki/authorities/local/root.crt && test \"$$(wget -q --no-check-certificate -O - https://chat.localhost:8443/_gateway/health)\" = ok && wget -q --no-check-certificate -O /dev/null https://chat.localhost:8443/.well-known/matrix/client"
        ],
        "timeout": "5s"
      },
      "image": "caddy@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648",
      "networks": {
        "control-internal": {
          "ipv4_address": "10.77.31.10"
        },
        "edge": {},
        "matrix-internal": {
          "aliases": [
            "chat.localhost",
            "auth.localhost",
            "matrix.localhost"
          ],
          "ipv4_address": "10.77.30.10"
        }
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8443",
          "target": 8443
        }
      ],
      "profiles": [
        "full",
        "negative"
      ],
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<repo>/deploy/local/gateway/Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "<repo>/deploy/local/well-known",
          "target": "/srv/well-known",
          "type": "bind"
        },
        {
          "source": "caddy-data",
          "target": "/data",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "caddy-config",
          "target": "/config",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "gateway-ca-export": {
      "command": [
        "find /caddy-ca -mindepth 1 -maxdepth 1 -exec rm -rf {} +; install -m 0444 /data/caddy/pki/authorities/local/root.crt /caddy-ca/root.crt"
      ],
      "depends_on": {
        "gateway": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "sh",
        "-ec"
      ],
      "image": "caddy@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648",
      "network_mode": "none",
      "profiles": [
        "full"
      ],
      "volumes": [
        {
          "read_only": true,
          "source": "caddy-data",
          "target": "/data",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "caddy-ca",
          "target": "/caddy-ca",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "mas": {
      "command": [
        "server",
        "--no-migrate"
      ],
      "depends_on": {
        "api": {
          "condition": "service_healthy",
          "required": true
        },
        "gateway-ca-export": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "mas-migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "synapse": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "MAS_CONFIG": "/config/config.yaml:/run/secrets/mas-secrets.yaml",
        "SSL_CERT_FILE": "/caddy-ca/root.crt"
      },
      "image": "ghcr.io/element-hq/matrix-authentication-service@sha256:1b0cc87ca6bd6186172a123228cfc3be4c94522d5ecc71e7baeaf23e48ce883a",
      "networks": {
        "matrix-internal": null
      },
      "profiles": [
        "full"
      ],
      "secrets": [
        {
          "source": "mas-secrets.yaml",
          "target": "/run/secrets/mas-secrets.yaml"
        },
        {
          "source": "mas-upstream-client-secret",
          "target": "/run/secrets/mas-upstream-client-secret"
        },
        {
          "source": "synapse-mas-shared-secret",
          "target": "/run/secrets/synapse-mas-shared-secret"
        },
        {
          "source": "mas-encryption-key",
          "target": "/run/secrets/mas-encryption-key"
        },
        {
          "source": "mas-signing-key.pem",
          "target": "/run/secrets/mas-signing-key.pem"
        }
      ],
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<repo>/deploy/local/mas/config.yaml",
          "target": "/config/config.yaml",
          "type": "bind"
        },
        {
          "read_only": true,
          "source": "caddy-ca",
          "target": "/caddy-ca",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "mas-migrate": {
      "command": [
        "database",
        "migrate"
      ],
      "depends_on": {
        "matrix-db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "MAS_CONFIG": "/config/config.yaml:/run/secrets/mas-secrets.yaml"
      },
      "image": "ghcr.io/element-hq/matrix-authentication-service@sha256:1b0cc87ca6bd6186172a123228cfc3be4c94522d5ecc71e7baeaf23e48ce883a",
      "networks": {
        "matrix-internal": null
      },
      "profiles": [
        "full"
      ],
      "secrets": [
        {
          "source": "mas-secrets.yaml",
          "target": "/run/secrets/mas-secrets.yaml"
        },
        {
          "source": "synapse-mas-shared-secret",
          "target": "/run/secrets/synapse-mas-shared-secret"
        },
        {
          "source": "mas-encryption-key",
          "target": "/run/secrets/mas-encryption-key"
        },
        {
          "source": "mas-signing-key.pem",
          "target": "/run/secrets/mas-signing-key.pem"
        },
        {
          "source": "mas-upstream-client-secret",
          "target": "/run/secrets/mas-upstream-client-secret"
        }
      ],
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<repo>/deploy/local/mas/config.yaml",
          "target": "/config/config.yaml",
          "type": "bind"
        }
      ]
    },
    "mas-ready": {
      "command": [
        "deadline=$$(($$(date +%s) + 60)); until wget -q -T 2 -O /dev/null http://mas:8081/health; do [ \"$$(date +%s)\" -lt \"$$deadline\" ] || exit 1; sleep 1; done"
      ],
      "depends_on": {
        "mas": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "sh",
        "-ec"
      ],
      "image": "caddy@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648",
      "networks": {
        "matrix-internal": null
      },
      "profiles": [
        "full"
      ]
    },
    "matrix-db": {
      "command": [
        "postgres",
        "-c",
        "max_connections=100"
      ],
      "entrypoint": null,
      "environment": {
        "POSTGRES_PASSWORD_FILE": "/run/secrets/matrix-root-password",
        "POSTGRES_USER": "postgres"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 12,
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres"
        ],
        "timeout": "5s"
      },
      "image": "postgres@sha256:4f736ae292687621d4dbe0d499ffd024a36bd2ee7d8ca6f2ccd4c800f047b394",
      "networks": {
        "matrix-internal": null
      },
      "profiles": [
        "full",
        "negative"
      ],
      "secrets": [
        {
          "source": "matrix-root-password",
          "target": "/run/secrets/matrix-root-password"
        },
        {
          "source": "synapse-db-password",
          "target": "/run/secrets/synapse-db-password"
        },
        {
          "source": "mas-db-password",
          "target": "/run/secrets/mas-db-password"
        }
      ],
      "volumes": [
        {
          "source": "matrix-db-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {},
          "read_only": true,
          "source": "<repo>/deploy/local/postgres/init-matrix-databases.sh",
          "target": "/docker-entrypoint-initdb.d/10-matrix.sh",
          "type": "bind"
        }
      ]
    },
    "migrate": {
      "build": {
        "args": {
          "BUILD_MARKER": "development",
          "NODE_IMAGE": "node@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd"
        },
        "context": "<repo>",
        "dockerfile": "backend/Dockerfile"
      },
      "command": [
        "sh",
        "-ec",
        "p=$$(cat /run/secrets/control-owner-db-password); export MIGRATION_DATABASE_URL=\"postgresql://$${POSTGRES_USER:-control_owner}:$$p@control-db/$${POSTGRES_DB:-control}\"; exec node dist/migrate.js"
      ],
      "depends_on": {
        "control-db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "CONTROL_PLANE_RETENTION_ROLE": "control_retention",
        "CONTROL_PLANE_REVOCATION_ROLE": "control_revocation",
        "CONTROL_PLANE_RUNTIME_ROLE": "control_runtime",
        "POSTGRES_DB": "control",
        "POSTGRES_USER": "control_owner",
        "REVOCATION_EVIDENCE_KEY_IDS": "v1"
      },
      "networks": {
        "control-internal": null
      },
      "profiles": [
        "full"
      ],
      "secrets": [
        {
          "source": "control-owner-db-password",
          "target": "/run/secrets/control-owner-db-password"
        }
      ],
      "user": "root"
    },
    "synapse": {
      "command": [
        "run",
        "-c",
        "/data/homeserver.yaml",
        "-c",
        "/run/secrets/synapse-secrets.yaml"
      ],
      "depends_on": {
        "matrix-db": {
          "condition": "service_healthy",
          "required": true
        },
        "synapse-data-init": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "entrypoint": null,
      "healthcheck": {
        "interval": "5s",
        "retries": 12,
        "test": [
          "CMD-SHELL",
          "curl -fSs http://127.0.0.1:8008/health >/dev/null"
        ],
        "timeout": "5s"
      },
      "image": "matrixdotorg/synapse@sha256:d2215c4a0e0bbd304489af228345b31d6857c1a228175471358d3fda187c0d91",
      "networks": {
        "matrix-internal": null
      },
      "profiles": [
        "full",
        "negative"
      ],
      "secrets": [
        {
          "source": "synapse-secrets.yaml",
          "target": "/run/secrets/synapse-secrets.yaml"
        },
        {
          "source": "synapse-mas-shared-secret",
          "target": "/run/secrets/synapse-mas-shared-secret"
        },
        {
          "source": "synapse-signing-key",
          "target": "/run/secrets/synapse-signing-key"
        }
      ],
      "volumes": [
        {
          "source": "synapse-data",
          "target": "/data",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {},
