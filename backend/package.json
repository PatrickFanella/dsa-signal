{
  "name": "@subculture/project-template-ts-vite-react-ts-postgres-docker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migration.mjs",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:oidc-compatibility": "vitest run src/oidc/compatibility-harness.test.ts",
    "test:oidc-smoke": "vitest run src/oidc/provider.test.ts src/oidc/compatibility-harness.test.ts",
    "format": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/migrate.js",
    "check:retained-keys": "node dist/check-retained-keys.js",
    "refresh-policy": "node dist/refresh-policy-cli.js",
    "restore:oidc": "node dist/oidc/restore-main.js",
    "activate:oidc": "node dist/oidc/activation-main.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@dsaslate/foundation-client": "0.2.0",
    "jose": "6.2.3",
    "lossless-json": "4.2.0",
    "oidc-provider": "9.9.1",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
