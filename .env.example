# Copy to .env for local development in derived projects.
# Never commit .env.

PROJECT_NAME=dsa-signal

# Optional local Postgres profile used by docker-compose.yml.
POSTGRES_DB=dsa_signal
POSTGRES_USER=dsa_signal
POSTGRES_PASSWORD=replace-for-local-docker-only
POSTGRES_PORT=5432

# Runtime, retention, revocation, and migration identities are separate. Placeholders below intentionally do not parse
# as production secrets. APP_ENV=test alone has deterministic test-only defaults.
APP_ENV=development
DATABASE_URL=postgresql://control_plane_runtime:REPLACE_ME@postgres:5432/dsa_signal?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://migration_owner:REPLACE_ME@postgres:5432/dsa_signal?sslmode=disable
CONTROL_PLANE_RUNTIME_ROLE=control_plane_runtime
CONTROL_PLANE_RETENTION_ROLE=control_plane_retention
CONTROL_PLANE_REVOCATION_ROLE=control_plane_revocation
REVOCATION_EVIDENCE_KEY_IDS=v1
PORT=8080
PUBLIC_BASE_URL=https://chat.example.invalid
FOUNDATION_BASE_URL=https://foundation.example.invalid
PWA_ORIGIN=https://chat.example.invalid
OIDC_SECTOR=https://mas.example.invalid
# Generate with: node -e "process.stdout.write(require('node:crypto').randomBytes(16).toString('base64url') + '\\n')"
OIDC_EPOCH=GENERATE_16_RANDOM_BYTES_CANONICAL_BASE64URL
OIDC_TRUSTED_PROXY_ADDRESS=127.0.0.1
MAS_CLIENT_ID=dsa-signal
MAS_REDIRECT_URI=https://mas.example.invalid/upstream/callback/01J00000000000000000000000
# Compose reads these host-only source paths and mounts them read-only at the fixed targets below.
# For direct runs, set the three *_PATH values to protected local files; never put secret contents in env.
OIDC_SIGNING_JWKS_SOURCE=./secrets/oidc-signing-jwks.json
MAS_CLIENT_SECRET_SOURCE=./secrets/mas-client-secret
OIDC_COOKIE_KEYS_SOURCE=./secrets/oidc-cookie-keys.json
# Files are mounted secrets; never put their contents in API environment variables.
OIDC_SIGNING_JWKS_PATH=/run/secrets/oidc-signing-jwks.json
MAS_CLIENT_SECRET_PATH=/run/secrets/mas-client-secret
OIDC_COOKIE_KEYS_PATH=/run/secrets/oidc-cookie-keys.json
# Immutable owner-only floor records outside database backup/PITR.
OIDC_RESTORE_FLOOR_DIR=/absolute/host/path/to/oidc-restore-floor
OIDC_RESTORE_FLOOR_HEAD=BQSLpPDcieO3Yt-iBZbnZTblaCULvwaJAAxi4Pd8TtA
COOKIE_SECURE=true
# Every ring is {"active":"v1","keys":{"v1":"<43-char-base64url-32-byte-key>"}}.
COOKIE_KEY=<43-char-base64url-32-byte-key>
SUBJECT_KEY_RING=<ring-json>
ENVELOPE_KEY_RING=<ring-json>
CHALLENGE_KEY_RING=<ring-json>
SESSION_BINDING_KEY_RING=<ring-json>
JTI_KEY_RING=<ring-json>
IDEMPOTENCY_KEY_RING=<ring-json>
REQUEST_FINGERPRINT_KEY_RING=<ring-json>
OIDC_ADAPTER_KEY_RING=<narrow-ring-json>
OIDC_INDEX_KEY_RING=<narrow-ring-json>
REVOCATION_EVIDENCE_KEY_RING=<ring-json>
ROOT_DIDS='["did:plc:replacewithpinnedroot"]'
# Map each configured root kid to an exact public P-256 JWK (never include private d).
ROOT_PUBLIC_JWKS='<root-kid-to-public-jwk-map>'
AUTHORITY_POLICY_VERSION=v1
POLICY_MAX_STALENESS_SECONDS=300
